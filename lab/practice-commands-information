!#/bin/bash
mkdir -p linux-file-types-and-testing
cd linux-file-types-and-testing

mkdir regular-files directories symlinks hardlinks scripts reports

echo "Learning Linux file types" > regular-files/notes.txt
echo 'echo "Hello from a Linux script"' > regular-files/script.sh
echo "This is a hidden file" > regular-files/.hidden-file

echo "Directory test file" > directories/example.txt
echo "Practice symbolic and hard links" > symlinks/practice-notes.md
echo "Hard link testing notes" > hardlinks/README.md
chmod +x regular-files/script.sh
