@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@THIS ARE THE FILE TEST THAT WHETHERE THEY ARE EXISTED OR NOT@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

test -f regular-files/notes.txt && echo "Regular file exists"
test -d directories && echo "Directory exists"
test -r regular-files/notes.txt && echo "File is readable"
test -w regular-files/notes.txt && echo "File is writable"
test -x regular-files/script.sh && echo "File is executable"


test -f directories && echo "This is a regular file"



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%PRACTIC THE SOFT LINK DONT WORY WE WILL SHOW OUR PRACTICE SEACION IN THE ANOTER FILE%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
ln -s ../regular-files/notes.txt symlinks/notes-link.txt

ls -l symlinks/notes-link.txt
readlink symlinks/notes-link.txt
cat symlinks/notes-link.txt

test -L symlinks/notes-link.txt && echo "This is a symbolic link"
test -e symlinks/notes-link.txt && echo "Its target exists"

mv regular-files/notes.txt regular-files/notes-temp.txt
test -L symlinks/notes-link.txt && echo "The link still exists"
test -e symlinks/notes-link.txt || echo "The link target is missing"

mv regular-files/notes-temp.txt regular-files/notes.txt

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$HARD LINK COMMANDS AND ITS CREATION&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
ln regular-files/notes.txt hardlinks/notes-hardlink.txt

ls -li regular-files/notes.txt hardlinks/notes-hardlink.txt
stat regular-files/notes.txt
stat hardlinks/notes-hardlink.txt

echo "Added through the hard link" >> hardlinks/notes-hardlink.txt
cat regular-files/notes.txt

rm regular-files/notes.txt
cat hardlinks/notes-hardlink.txt
cp hardlinks/notes-hardlink.txt regular-files/notes.txt


